# Normalize text to LF in the repo so scripts behave the same on Windows, macOS, Linux and Cloud Shell.
* text=auto eol=lf

# Windows-only formats keep CRLF.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Bash must stay LF or Cloud Shell fails with "$'\r': command not found".
*.sh   text eol=lf
*.in   text eol=lf

# Binary files: never touch line endings.
*.png  binary
*.jpg  binary
*.docx binary
*.tm7  binary
*.zip  binary
