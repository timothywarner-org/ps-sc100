# .env.example -- every setting the toolkit reads, with its default.
#
# THE LOCAL PATH NEEDS NO .env AT ALL. Every value below has a working default, and every
# path resolves relative to the toolkit folder. Copy this file to .env only when you want
# to change something.
#
# The optional Azure path writes .env for you: infra/deploy.ps1 (or deploy.sh) fills the
# AZURE_* values from the deployment outputs, so you never copy an endpoint by hand.
#
# THERE ARE NO SECRETS IN THIS FILE, BY DESIGN. infra/main.bicep sets disableLocalAuth=true
# on the search service and the Foundry account and allowSharedKeyAccess=false on storage,
# so none of them accepts an API key. Every Azure client authenticates with Microsoft
# Entra ID through DefaultAzureCredential, which picks up your `az login` session.
#
# Never commit your real .env. The toolkit's .gitignore blocks it.

# --- Retrieval backend ------------------------------------------------------------
# local  (default) Chroma on your disk. Zero cost, no Azure, works offline.
# azure  The optional Azure AI Search index. Adds BM25 and the semantic ranker, and
#        bills by the hour while the search service exists.
SC100_BACKEND=local

# --- Local paths ------------------------------------------------------------------
# Relative paths here resolve against the TOOLKIT folder, because that is where .env
# lives. A --path or --input argument on a tool resolves against your current directory.
SC100_CHROMA_PATH=./index/learn-chroma
SC100_CHUNKS=./index/learn-chunks.jsonl
SC100_CORPUS_DIR=./corpus

# --- Optional Azure path (written by infra/deploy.ps1) ----------------------------
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-sc100-knowledge
AZURE_LOCATION=eastus2

AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_SERVICE=
AZURE_SEARCH_INDEX=sc100-learn

AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_NAME=
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_EMBEDDING_MODEL=text-embedding-3-large
# Pinned rather than floating so a run is reproducible.
AZURE_OPENAI_API_VERSION=2024-10-21

# Corpus snapshot archive (tools/sync_corpus.py). A private provenance store, NOT an
# ingestion source: nothing in Azure reads from it.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_BLOB_ENDPOINT=
AZURE_CORPUS_SOURCE_CONTAINER=corpus-source
AZURE_CORPUS_ARTIFACTS_CONTAINER=corpus-artifacts
